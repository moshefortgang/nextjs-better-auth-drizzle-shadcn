# Example environment variables for local development
# Copy this file to `.env` and edit values before running the app.

# Postgres (used by drizzle + better-auth drizzle adapter)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nextjs
# Connection string used in the application (on Vercel: https://vercel.com/postgres)
POSTGRES_URL=postgres://postgres:changeme@localhost:5432/nextjs

# Better Auth
# Generate one here: https://generate-secret.vercel.app/32
BETTER_AUTH_SECRET=
# Server-side base URL of the app
BETTER_AUTH_URL=http://localhost:3000

# OAuth (Google) - replace with your credentials if using OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Comma-separated user IDs that always have admin access (bootstrap the first admin)
ADMIN_USER_IDS=
